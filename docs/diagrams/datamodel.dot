digraph data {
  graph [bgcolor="white", fontname="Helvetica", rankdir=LR, nodesep=0.6, ranksep=0.6, pad=0.3];
  node  [fontname="Helvetica", fontsize=10, shape=record, style="filled", penwidth=1.3];
  edge  [style=invis];

  users [label="{users  (relational · SQLAlchemy)|id  PK\lauth0_sub  (unique, indexed)\lemail\ltier  (free / pro / studio)\lstripe_customer_id\lstripe_subscription_id\lcreated_at\l}",
         fillcolor="#fef3c7", color="#a16207"];
  segs  [label="{segments  (ChromaDB · vector)|id = video_id-i\lembedding  (CLIP vector)\lvideo_id\ltimestamp\lframe_path\ltranscript_segment\l}",
         fillcolor="#dcfce7", color="#4a7a22"];
  vids  [label="{VIDEOS  (in-memory dict)|status · progress\ltotal_segments · error\lsource · title\lcreated · owner\l}",
         fillcolor="#e2e8f0", color="#64748b"];

  users -> segs -> vids;
}
